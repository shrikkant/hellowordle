# Google OAuth 2.0 Web client ID (Google Cloud Console -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Secret used to sign app JWTs — set to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Postgres connection (docker-compose-infra.yml provides it)
DATABASE_URL=postgres://wordbaazi:wordbaazi@localhost:5432/wordbaazi
