# Copy to .env before running `docker compose up`.

# Required — sign the app's session JWTs. Generate one: openssl rand -hex 32
JWT_SECRET=

# Optional — Google OAuth Web client ID (enables Sign in with Google).
# Used by the API to verify tokens AND baked into the web build.
GOOGLE_CLIENT_ID=

# Postgres password (must match what docker-compose-infra.yml was started with)
DB_PASSWORD=wordbaazi

# Host port the web app is published on (http://localhost:7654 by default).
WEB_PORT=7654
